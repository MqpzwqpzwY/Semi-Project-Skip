<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="mybatis.mapper.RentalShopMapper">
    <select id="getInfo" resultType="dto.RentalShopDTO" parameterType="int">
        SELECT * FROM rentalshop WHERE rentalshop_id = #{id}
    </select>

    <select id="getList" resultType="arraylist">
        select * from rentalshop
    </select>

    <insert id="insertRentalShop" parameterType="dto.RentalShopDTO">
        insert into rentalshop values(rentalshop.nextval, #{uuid}, #{rename} ,
        #{location}, #{remain_img}, #{resub_img1}, #{resub_img2}, #{resub_img3}, #{description}, sysdate);
    </insert>

    <delete id="deleteRentalShop" parameterType="int">
        delete from rent_item where rentalshop_id = #{rentalshop_id}
    </delete>
</mapper>
